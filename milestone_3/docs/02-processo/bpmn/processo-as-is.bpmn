      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Ev_Chamada" bpmnElement="Ev_Chamada">
        <dc:Bounds x="772" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Dirigir" bpmnElement="Task_Dirigir">
        <dc:Bounds x="840" y="98" width="130" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Ev_Fim_Cidadao" bpmnElement="Ev_Fim_Cidadao">
        <dc:Bounds x="1012" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Ev_Pedido" bpmnElement="Ev_Pedido">
        <dc:Bounds x="307" y="312" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Prioridade" bpmnElement="GW_Prioridade" isMarkerVisible="true">
        <dc:Bounds x="395" y="305" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_EmitirPrioritaria" bpmnElement="Task_EmitirPrioritaria">
        <dc:Bounds x="475" y="264" width="140" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_EmitirNormal" bpmnElement="Task_EmitirNormal">
        <dc:Bounds x="475" y="344" width="140" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Entregar" bpmnElement="Task_Entregar">
        <dc:Bounds x="650" y="302" width="130" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Ev_Entregue" bpmnElement="Ev_Entregue">
        <dc:Bounds x="822" y="312" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Ev_Guiche" bpmnElement="Ev_Guiche">
        <dc:Bounds x="682" y="502" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Chamar" bpmnElement="Task_Chamar">
        <dc:Bounds x="835" y="492" width="130" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Compareceu" bpmnElement="GW_Compareceu" isMarkerVisible="true">
        <dc:Bounds x="985" y="495" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Atender" bpmnElement="Task_Atender">
        <dc:Bounds x="1075" y="492" width="130" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Resolvido" bpmnElement="GW_Resolvido" isMarkerVisible="true">
        <dc:Bounds x="1245" y="495" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Registrar" bpmnElement="Task_Registrar">
        <dc:Bounds x="1335" y="492" width="130" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Ev_Registrado" bpmnElement="Ev_Registrado">
        <dc:Bounds x="1502" y="502" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Encaminhar" bpmnElement="Task_Encaminhar">
        <dc:Bounds x="1205" y="602" width="130" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RegistrarAusencia" bpmnElement="Task_RegistrarAusencia">
        <dc:Bounds x="945" y="602" width="130" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Ev_Descartada" bpmnElement="Ev_Descartada">
        <dc:Bounds x="1152" y="612" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_C1" bpmnElement="Flow_C1"><di:waypoint x="218" y="130" /><di:waypoint x="260" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C2" bpmnElement="Flow_C2"><di:waypoint x="390" y="130" /><di:waypoint x="430" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C3" bpmnElement="Flow_C3"><di:waypoint x="560" y="130" /><di:waypoint x="600" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C4" bpmnElement="Flow_C4"><di:waypoint x="730" y="130" /><di:waypoint x="772" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C5" bpmnElement="Flow_C5"><di:waypoint x="808" y="130" /><di:waypoint x="840" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_C6" bpmnElement="Flow_C6"><di:waypoint x="970" y="130" /><di:waypoint x="1012" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_O1" bpmnElement="Flow_O1"><di:waypoint x="343" y="330" /><di:waypoint x="395" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_O2" bpmnElement="Flow_O2"><di:waypoint x="420" y="305" /><di:waypoint x="420" y="290" /><di:waypoint x="475" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_O3" bpmnElement="Flow_O3"><di:waypoint x="420" y="355" /><di:waypoint x="420" y="370" /><di:waypoint x="475" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_O4" bpmnElement="Flow_O4"><di:waypoint x="615" y="290" /><di:waypoint x="630" y="290" /><di:waypoint x="630" y="330" /><di:waypoint x="650" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_O5" bpmnElement="Flow_O5"><di:waypoint x="615" y="370" /><di:waypoint x="630" y="370" /><di:waypoint x="630" y="330" /><di:waypoint x="650" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_O6" bpmnElement="Flow_O6"><di:waypoint x="780" y="330" /><di:waypoint x="822" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_O7" bpmnElement="Flow_O7"><di:waypoint x="718" y="520" /><di:waypoint x="835" y="520" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_O8" bpmnElement="Flow_O8"><di:waypoint x="965" y="520" /><di:waypoint x="985" y="520" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_O9" bpmnElement="Flow_O9"><di:waypoint x="1035" y="520" /><di:waypoint x="1075" y="520" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_O10" bpmnElement="Flow_O10"><di:waypoint x="1010" y="545" /><di:waypoint x="1010" y="602" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_O11" bpmnElement="Flow_O11"><di:waypoint x="1205" y="520" /><di:waypoint x="1245" y="520" /></bpmndi:BPMNEdge>
