      <bpmndi:BPMNEdge id="Edge_O16" bpmnElement="Flow_O16"><di:waypoint x="1075" y="630" /><di:waypoint x="1152" y="630" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_MF_1" bpmnElement="MF_1"><di:waypoint x="325" y="162" /><di:waypoint x="325" y="312" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MF_2" bpmnElement="MF_2"><di:waypoint x="715" y="302" /><di:waypoint x="715" y="200" /><di:waypoint x="495" y="200" /><di:waypoint x="495" y="162" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MF_3" bpmnElement="MF_3"><di:waypoint x="900" y="492" /><di:waypoint x="900" y="200" /><di:waypoint x="790" y="200" /><di:waypoint x="790" y="148" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MF_4" bpmnElement="MF_4"><di:waypoint x="940" y="162" /><di:waypoint x="940" y="212" /><di:waypoint x="1140" y="212" /><di:waypoint x="1140" y="492" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
